# 1. Delete the stale DerivedData
rm -rf ~/Library/Developer/Xcode/DerivedData/MessageX-*

# 2. Build fresh, targeting active arch only (arm64 on Apple Silicon)
cd ~/Downloads/IOS\ projects/MessageX
xcodebuild \
  -project MessageX.xcodeproj \
  -scheme MessageX \
  -destination 'platform=iOS Simulator,name=iPhone 16' \
  ONLY_ACTIVE_ARCH=YES \
  CODE_SIGNING_ALLOWED=NO \
  CODE_SIGNING_REQUIRED=NO \
  build 2>&1 | tail -60
